# --- Next.js app (browser-visible) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Optional: channel name, change only if you run two games at once
NEXT_PUBLIC_ROOM=pyl-room

# --- Shared between the app and the bot ---
# Any long random string. The bot sends it as x-bot-secret when registering tokens.
BOT_SECRET=change-me-to-something-random

# --- Discord bot only ---
DISCORD_TOKEN=your-bot-token
DISCORD_CHANNEL_ID=123456789012345678
# Where the Next.js app is reachable from the bot (no trailing slash)
APP_URL=http://localhost:3000
